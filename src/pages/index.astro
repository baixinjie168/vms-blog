---
import { env as cfEnv } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import TopSlotCard from '../components/TopSlotCard';
import CognitiveLevels from '../components/CognitiveLevels';
import AlbumList from '../components/AlbumList';
import { BlogService, DIMENSIONS, DEFAULT_ALBUMS } from '../services/blogService';

export const prerender = false;

// 1. 获取 Cloudflare D1 边缘数据库连接
const db = cfEnv?.DB || (Astro.locals as any)?.runtime?.env?.DB;

// 2. 初始化回退数据（确保构建阶段与无 DB 场景零报错）
let authorProfile = {
  id: 'usr_author_bai',
  nickname: '白心解',
  email: 'admin@250258.xyz',
  bio: '以道明向，以心修己，以法立律，以术精工，以器致远，以事立业，以势乘风。',
  avatar_url: null,
  avatar_bg: 'bg-stone-900',
  role: 'admin',
  github_url: 'https://github.com/baixinjie168',
  articleCount: 18,
  totalWords: '34.2w',
  daysCount: 430,
};

let categoryStats = {
  dimensions: Object.values(DIMENSIONS).map((d) => ({ ...d, count: 0 })),
  totalArticles: 18,
};

let calendarDots: Record<string, number> = {};
let albums = DEFAULT_ALBUMS;

// 3. 服务端动态拉取真实数据
if (db) {
  try {
    const now = new Date();
    const [profile, catStats, dots, albumList] = await Promise.all([
      BlogService.getAuthorProfile(db),
      BlogService.getCategoryStats(db),
      BlogService.getCalendarDots(db, now.getFullYear(), now.getMonth() + 1),
      BlogService.getAlbums(db),
    ]);
    authorProfile = profile;
    categoryStats = catStats;
    calendarDots = dots;
    albums = albumList;
  } catch (err) {
    console.error('Failed to fetch blog data in SSR:', err);
  }
}
---

<BaseLayout title="VMS · 未鸣时 · 数字花园">
  <!-- 模块二：全站顶栏 (带免密登录与搜索) -->
  <Header />

  <!-- 页面主体：三栏黄金结构，撑满整屏 (max-w-[1680px], 100vh 零长视窗) -->
  <main id="view-home" class="max-w-[1680px] mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-2.5 w-full flex-1 min-h-0 flex flex-col">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr_305px] xl:grid-cols-[295px_1fr_325px] gap-3 items-stretch h-full min-h-0 flex-1">
      
      <!-- ======================================================== -->
      <!-- 左侧边栏：文渊日历/个人独白(支持对调) + 七大认知层级体系 -->
      <!-- ======================================================== -->
      <aside class="flex flex-col h-full min-h-0 justify-between gap-2.5 flex-shrink-0">
        <TopSlotCard
          client:load
          slotPosition="left"
          authorProfile={authorProfile}
          calendarDots={calendarDots}
          daysCount={authorProfile.daysCount}
        />
        <CognitiveLevels
          client:load
          dimensions={categoryStats.dimensions}
          totalArticles={categoryStats.totalArticles}
        />
      </aside>

      <!-- ======================================================== -->
      <!-- 中间主内容区 (等待模块五：46px状态条 + 9卡片矩阵 + 38px分页条) -->
      <!-- ======================================================== -->
      <section class="h-full min-h-0 bg-white/60 backdrop-blur-xs rounded-2xl border border-stone-200/90 shadow-sm p-6 sm:p-8 flex flex-col items-center justify-center text-center select-none">
        <div class="max-w-md w-full space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-limeLight text-limeDark text-xs font-mono font-medium border border-limeBrand/25">
            <span>● 模块四已就绪：右栏独白名片 & 专栏专辑流就位</span>
          </div>

          <h2 class="text-xl font-serif font-bold text-stone-900">
            七维认知矩阵 × 7大专栏专辑已联动
          </h2>
          <p class="text-xs text-stone-500 font-serif leading-relaxed">
            左栏与右栏已完整组装！左右卡片支持一键位置互换并持久记忆。<br />
            点击左侧七维分类或右侧专栏专辑，两大筛选大项与响应式 Store 完美互斥联动。<br />
            接下来推进模块五（中栏 46px 状态条、9 张装帧卡片与分页控制条）。
          </p>

          <div class="pt-2 flex items-center justify-center gap-2 text-[11px] font-mono text-stone-400">
            <span class="px-2 py-0.5 rounded bg-stone-100 text-stone-600">左栏 (日历+七维)</span>
            <span>+</span>
            <span class="px-2 py-0.5 rounded bg-limeLight text-limeDark border border-limeBrand/20">右栏 (独白+专辑)</span>
            <span>➔</span>
            <span class="px-2 py-0.5 rounded bg-stone-100">待装配：中栏 9 卡片 (模块五)</span>
          </div>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- 右侧边栏：个人独白/文渊日历(支持对调) + 专栏专辑流 (模块四落地) -->
      <!-- ======================================================== -->
      <aside class="flex flex-col h-full min-h-0 justify-between gap-2.5 flex-shrink-0">
        <TopSlotCard
          client:load
          slotPosition="right"
          authorProfile={authorProfile}
          calendarDots={calendarDots}
          daysCount={authorProfile.daysCount}
        />
        <AlbumList
          client:load
          albums={albums}
        />
      </aside>

    </div>
  </main>
</BaseLayout>
