---
import { env as cfEnv } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import TopSlotCard from '../components/TopSlotCard';
import CognitiveLevels from '../components/CognitiveLevels';
import CenterColumn from '../components/CenterColumn';
import AlbumList from '../components/AlbumList';
import BookReader from '../components/BookReader';
import Editor from '../components/Editor';
import { BlogService, DIMENSIONS, DEFAULT_ALBUMS, DEFAULT_ARTICLES } from '../services/blogService';

export const prerender = false;

// 1. 获取 Cloudflare D1 边缘数据库连接
const db = cfEnv?.DB || (Astro.locals as any)?.runtime?.env?.DB;

// 2. 检测当前登录用户状态
const sessionUser = (Astro.locals as any)?.user;
const isGuest = !sessionUser;
const currentUserId = sessionUser?.id || sessionUser?.sub;

// 3. 初始化回退数据（确保构建阶段与无 DB 场景零报错）
let authorProfile = {
  id: isGuest ? 'guest' : (currentUserId || 'usr_author_bai'),
  nickname: isGuest ? '访客读者' : (sessionUser?.nickname || '白心解'),
  email: isGuest ? '' : (sessionUser?.email || 'admin@250258.xyz'),
  bio: isGuest
    ? '登入开启个人名片与创作空间，沉淀您的七维认知体系与专栏长卷。'
    : '以道明向，以心修己，以法立律，以术精工，以器致远，以事立业，以势乘风。',
  avatar_url: null,
  avatar_bg: isGuest ? 'bg-stone-300' : 'bg-stone-900',
  role: isGuest ? 'guest' : (sessionUser?.role || 'user'),
  github_url: isGuest ? null : 'https://github.com/baixinjie168',
  articleCount: isGuest ? 0 : 0,
  totalWords: isGuest ? '0' : '0',
  daysCount: isGuest ? 0 : 1,
  isGuest,
};

let categoryStats = {
  dimensions: Object.values(DIMENSIONS).map((d) => ({ ...d, count: 0 })),
  totalArticles: 0,
  isGuest,
};

let calendarDots: Record<string, number> = {};
let albums = DEFAULT_ALBUMS;
let initialArticlesResult = {
  data: isGuest ? DEFAULT_ARTICLES.slice(0, 9) : [],
  total: isGuest ? DEFAULT_ARTICLES.length : 0,
  page: 1,
  pageSize: 9,
  totalPages: isGuest ? Math.ceil(DEFAULT_ARTICLES.length / 9) : 1,
};

// 4. 服务端动态拉取真实数据
if (db) {
  try {
    const now = new Date();
    const [profile, catStats, dots, albumList, articlesRes] = await Promise.all([
      BlogService.getAuthorProfile(db, currentUserId),
      BlogService.getCategoryStats(db, currentUserId),
      BlogService.getCalendarDots(db, now.getFullYear(), now.getMonth() + 1, currentUserId),
      BlogService.getAlbums(db, currentUserId),
      BlogService.getArticles(db, {
        page: 1,
        pageSize: 9,
        authorId: currentUserId || undefined,
      }),
    ]);
    authorProfile = profile;
    categoryStats = catStats;
    calendarDots = dots;
    albums = albumList;
    initialArticlesResult = articlesRes;
  } catch (err) {
    console.error('Failed to fetch blog data in SSR:', err);
  }
}
---

<BaseLayout title="VMS · 未鸣时 · 数字花园">
  <!-- 模块二：全站顶栏 (带读者登录注册与全库搜索) -->
  <Header />

  <!-- 页面主体：三栏黄金结构，撑满整屏 (max-w-[1680px], 100vh 零长视窗) -->
  <main id="view-home" class="max-w-[1680px] mx-auto px-2.5 sm:px-6 lg:px-8 py-2 sm:py-2.5 w-full flex-1 min-h-0 flex flex-col">
    <!-- 移动端视图切换胶囊栏 (仅在 lg 以下移动设备与平板显示) -->
    <div class="flex lg:hidden items-center justify-around bg-white p-1 rounded-xl border border-stone-200/90 shadow-2xs mb-2 flex-shrink-0 text-xs font-serif select-none">
      <button id="tab-btn-articles" type="button" class="mobile-tab-btn flex-1 py-1.5 px-2 rounded-lg font-bold transition text-center bg-limeLight text-limeDark cursor-pointer">
        📜 卷帙文章
      </button>
      <button id="tab-btn-cognitive" type="button" class="mobile-tab-btn flex-1 py-1.5 px-2 rounded-lg text-stone-600 transition text-center hover:bg-stone-50 cursor-pointer">
        🧭 七维体系
      </button>
      <button id="tab-btn-albums" type="button" class="mobile-tab-btn flex-1 py-1.5 px-2 rounded-lg text-stone-600 transition text-center hover:bg-stone-50 cursor-pointer">
        📚 专栏专辑
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr_305px] xl:grid-cols-[295px_1fr_325px] gap-3 items-stretch h-full min-h-0 flex-1">
      
      <!-- ======================================================== -->
      <!-- 左侧边栏：文渊日历/个人独白(支持对调) + 七大认知层级体系 -->
      <!-- ======================================================== -->
      <aside id="col-left" class="hidden lg:flex flex-col h-full min-h-0 justify-between gap-2.5 flex-shrink-0">
        <TopSlotCard
          client:load
          slotPosition="left"
          authorProfile={authorProfile}
          calendarDots={calendarDots}
          daysCount={authorProfile.daysCount}
          isGuest={isGuest}
        />
        <CognitiveLevels
          client:load
          dimensions={categoryStats.dimensions}
          totalArticles={categoryStats.totalArticles}
          isGuest={isGuest}
        />
      </aside>

      <!-- ======================================================== -->
      <!-- 中间主内容区：46px状态条 + 9张装帧卡片 + 38px分页条 (模块五落地) -->
      <!-- ======================================================== -->
      <div id="col-center" class="flex flex-col min-w-0 h-full min-h-0 justify-between gap-2 flex-1">
        <CenterColumn
          client:load
          initialArticles={initialArticlesResult.data}
          initialTotal={initialArticlesResult.total}
        />
      </div>

      <!-- ======================================================== -->
      <!-- 右侧边栏：个人独白/文渊日历(支持对调) + 专栏专辑流 (模块四落地) -->
      <!-- ======================================================== -->
      <aside id="col-right" class="hidden lg:flex flex-col h-full min-h-0 justify-between gap-2.5 flex-shrink-0">
        <TopSlotCard
          client:load
          slotPosition="right"
          authorProfile={authorProfile}
          calendarDots={calendarDots}
          daysCount={authorProfile.daysCount}
          isGuest={isGuest}
        />
        <AlbumList
          client:load
          albums={albums}
          isGuest={isGuest}
        />
      </aside>

    </div>
  </main>

  <!-- 翻书沉浸阅读器客户端岛屿 (沉浸慢读) -->
  <BookReader client:load />

  <!-- 阶段六：富文本创作与双屏实时排版预览客户端岛屿 -->
  <Editor client:load />

  <script>
    const tabArticles = document.getElementById('tab-btn-articles');
    const tabCognitive = document.getElementById('tab-btn-cognitive');
    const tabAlbums = document.getElementById('tab-btn-albums');
    const colLeft = document.getElementById('col-left');
    const colCenter = document.getElementById('col-center');
    const colRight = document.getElementById('col-right');

    function switchMobileTab(activeBtn: HTMLElement | null) {
      const tabs = [
        { btn: tabArticles, col: colCenter },
        { btn: tabCognitive, col: colLeft },
        { btn: tabAlbums, col: colRight },
      ];

      tabs.forEach(({ btn, col }) => {
        if (btn === activeBtn) {
          btn?.classList.add('bg-limeLight', 'text-limeDark', 'font-bold');
          btn?.classList.remove('text-stone-600');
          col?.classList.remove('hidden');
          col?.classList.add('flex');
        } else {
          btn?.classList.remove('bg-limeLight', 'text-limeDark', 'font-bold');
          btn?.classList.add('text-stone-600');
          col?.classList.add('hidden');
          col?.classList.remove('flex');
        }
      });
    }

    tabArticles?.addEventListener('click', () => switchMobileTab(tabArticles));
    tabCognitive?.addEventListener('click', () => switchMobileTab(tabCognitive));
    tabAlbums?.addEventListener('click', () => switchMobileTab(tabAlbums));
  </script>
</BaseLayout>
