---
import AuthModal from './AuthModal';
---

<header class="h-[48px] bg-white/95 backdrop-blur-md border-b border-stone-200/90 px-3 sm:px-6 flex items-center justify-between flex-shrink-0 select-none shadow-2xs z-30">
  <!-- 左侧：品牌 Logo 与哲学副标 -->
  <div class="flex items-center space-x-3.5">
    <a href="/" class="flex items-center space-x-2.5 group cursor-pointer">
      <div class="relative">
        <div class="w-8 h-8 rounded-xl bg-limeBrand text-white flex items-center justify-center font-bold text-sm shadow-xs border border-white/40 group-hover:bg-limeDark transition-colors">
          V
        </div>
        <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded bg-stone-900 text-white flex items-center justify-center text-[8px] font-serif font-black shadow border border-white">
          鸣
        </div>
      </div>

      <div class="flex items-baseline space-x-2">
        <span class="font-serif font-black text-sm sm:text-base text-stone-900 tracking-wide">
          VMS · 未鸣时
        </span>
        <span class="hidden sm:inline text-[9px] px-1.5 py-0.5 rounded-full bg-limeLight text-limeDark font-mono font-semibold border border-limeBrand/20">
          250258.xyz
        </span>
      </div>
    </a>

    <!-- 七字真言 -->
    <div class="hidden lg:flex items-center space-x-1.5 text-[10px] text-stone-400 font-serif border-l border-stone-200 pl-3.5">
      <span>道</span><span>·</span>
      <span>心</span><span>·</span>
      <span>法</span><span>·</span>
      <span>术</span><span>·</span>
      <span>器</span><span>·</span>
      <span>事</span><span>·</span>
      <span>势</span>
    </div>
  </div>

  <!-- 右侧：全库搜索 + 写作入口 + 免密登入岛屿 -->
  <div class="flex items-center space-x-2.5 sm:space-x-3">
    <!-- 全库搜索框 -->
    <div class="relative hidden sm:block w-36 md:w-48 lg:w-60">
      <input
        id="global-search-input"
        type="text"
        placeholder="检索道心法术器事势..."
        class="w-full bg-stone-100 text-xs px-3 py-1.5 pl-7 rounded-full border border-stone-200 focus:outline-none focus:border-limeBrand focus:bg-white transition-all font-serif placeholder:text-stone-400"
      />
      <svg class="w-3.5 h-3.5 text-stone-400 absolute left-2.5 top-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </div>

    <!-- 写作与预览按钮 (未来阶段衔接) -->
    <button
      id="btn-header-write"
      onclick="alert('写作引擎与 Tiptap 实时排版预览将在阶段四无感接驳')"
      class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-700 text-xs font-serif transition active:scale-95 border border-stone-200 cursor-pointer"
      title="撰写新文章"
    >
      <svg class="w-3 h-3 text-[#C04838]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
        <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
        <path d="M2 2l7.586 7.586"></path>
        <circle cx="11" cy="11" r="2"></circle>
      </svg>
      <span class="hidden md:inline">写文章</span>
    </button>

    <!-- 客户端免密登录认证岛屿 -->
    <AuthModal client:load />
  </div>
</header>
