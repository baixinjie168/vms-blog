---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "VMS", 
  description = "融合实体书卷纸墨装帧与现代架构的高品质个人博客" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN" class="h-full antialiased">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
</head>
<body class="bg-paperBg text-[#222222] h-screen overflow-hidden flex flex-col font-sans selection:bg-limeBrand selection:text-white">
  <slot />
</body>
</html>
